<article class="tarjeta">
  <a class="tarjeta-media" href="${ctx}/producto?id=${p.id}" aria-label="Ver ${p.nombre}">
    <c:choose>
      <c:when test="${fn:contains(p.emoji, '.')}">
        <img class="img-producto" src="${ctx}/assets/img/${p.emoji}" alt="" loading="lazy">
      </c:when>
      <c:otherwise><span class="emoji" aria-hidden="true">${p.emoji}</span></c:otherwise>
    </c:choose>
  </a>
  <div class="tarjeta-cuerpo">
    <h3><a href="${ctx}/producto?id=${p.id}">${p.nombre}</a></h3>
    <p class="suave">${p.categoria}</p>
    <div class="tarjeta-pie">
      <strong class="precio"><fmt:formatNumber value="${p.precio}" pattern="Q#,##0.00"/></strong>
      <form class="form-agregar" method="post" action="${ctx}/carrito">
        <input type="hidden" name="accion" value="agregar">
        <input type="hidden" name="id" value="${p.id}">
        <button class="btn-mas" type="submit" aria-label="Agregar ${p.nombre} al carrito">+</button>
      </form>
    </div>
  </div>
</article>
